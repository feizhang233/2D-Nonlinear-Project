  },
  "sign_conventions": {
    "equilibrium": "r(q,lambda) = f_int(q) - lambda f_ref = 0",
    "initial_stress_form": "(K_M + lambda K_sigma_ref) phi = 0; compression usually weakens through negative K_sigma_ref",
    "positive_weakening_form": "K_M phi = lambda K_G phi with K_G = -K_sigma_ref",
    "rule": "Never mix the two forms or take absolute eigenvalues without resolving the sign convention."
  },
  "analysis_levels": [
    {
      "id": "LBA",
      "name": "linear buckling analysis",
      "can_answer": ["ideal critical multiplier", "ideal buckling mode", "mesh and boundary sensitivity"],
      "cannot_answer": ["imperfection-reduced limit load", "post-buckling path", "design strength"]
    },
    {
      "id": "GNA",
      "name": "geometrically nonlinear analysis of perfect geometry",
      "can_answer": ["perfect-geometry path", "limit point", "candidate bifurcation"],
      "cannot_answer": ["manufacturing imperfection scatter", "material yielding"]
    },
    {
      "id": "GNIA",
      "name": "geometrically nonlinear analysis with imperfection",
      "can_answer": ["imperfection sensitivity", "imperfection-reduced path and limit load"],
      "cannot_answer": ["plasticity and residual-stress effects"]
    },
    {
      "id": "GMNIA",
      "name": "geometrically and materially nonlinear analysis with imperfection",
      "can_answer": ["engineering path within the specified material imperfection and boundary model"],
      "cannot_answer": ["unmodeled contact", "imperfection statistics", "model uncertainty"]
    }
  ],
